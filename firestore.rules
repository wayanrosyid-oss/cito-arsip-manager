rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /test/{docId} {
      allow read, write: if true;
    }

    // Trips collection: readable and writable for all devices
    match /trips/{tripId} {
      allow read, write: if true;
    }

    // Global settings collection: readable and writable for all devices
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
